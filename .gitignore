# Xsegon's own data: settings, library, logs and pictures
data/*

# The console pictures you choose (data/platform-art/) are yours, not the
# repo's: the Backup tool (Settings > Library) saves them.

# The packed Games Database: built by tools\build-gamesdb.php, published on its
# own GitHub release and put in the download by tools\make-test-copy.js;
# never in the repo, where each refresh would add 70 MB to the history.
gamesdb/gamesdb.sqlite.bz2*
gamesdb/gamesdb.json
gamesdb/gamesdb.sig

# 7-Zip's small extractor and its licence: fetched by version and checked
# against its hash (tools\get-7zr.js), carried by every package, not kept here
bin/7zr.exe
bin/7zr.exe.part
bin/7zr-LICENSE.txt

# ffmpeg, which packages carried before Xsegon cut and joined videos itself
# (includes\mp4.php): a checkout may still hold it, and never commits it
bin/ffmpeg.exe
bin/ffmpeg-LICENSE.txt

# Five sounds of the built-in set that every package carries and git never
# holds: private\tools puts them here.
sounds/Xsegon/Move.wav
sounds/Xsegon/Select.wav
sounds/Xsegon/Back.wav
sounds/Xsegon/Ok.wav
sounds/Xsegon/Startup.wav

# never
roms/
*.lpl
# the Games folder a copy with no games folder makes for itself on its first
# start (includes\scan.php), when it is run from a checkout
/Games/

# test output (screenshots of failures, browser profiles)
tests/out/

# The docs are the maker's own: plans, notes, the wiki and its pages. Only the
# changelog (What's new reads it, every package carries it) and the README's
# pictures are public.
doc/*
!doc/CHANGELOG.md
!doc/screens/

# The maker's own parts: the wiki, the display guard, Find videos from Package
# and the privacy scan's word list. Xsegon runs without them.
private/

# A person's own look (a stylesheet read after Xsegon's, their pictures):
# theirs, never in a download, never replaced by an update.
custom/

# stray logs from other tools (log_screens is a Skraper run log: ROM paths
# and file names from this machine)
log_screens
*.log

# editor, Windows and leftover files
.vscode/
# this machine's own Claude Code permissions (pre-approved test commands)
.claude/settings.local.json
Microsoft/
Thumbs.db
desktop.ini
*.bak
*.orig
*.tmp
*.before-*

# PHP as a download carries it (tools\make-test-copy.js puts it in the
# package); never part of a checkout
/runtime/
